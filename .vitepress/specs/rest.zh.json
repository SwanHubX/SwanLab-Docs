{
  "openapi": "3.1.0",
  "info": {
    "title": "SwanLab API",
    "description": "SwanLab 开放 API 文档，包含 OAuth2 授权与使用接口，以及私有化 root 管理接口。",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "OAuth2 校验",
      "description": "OAuth2 Access Token 的获取与刷新校验"
    },
    {
      "name": "用户信息获取",
      "description": "使用 Access Token 获取用户信息与 API Key"
    },
    {
      "name": "根用户管理",
      "description": "根用户创建与密码管理接口"
    },
    {
      "name": "用户管理",
      "description": "用户与团队成员管理接口"
    },
    {
      "name": "协作者管理",
      "description": "项目协作者管理接口"
    }
  ],
  "paths": {
    "/self_hosted/root": {
      "post": {
        "operationId": "self-hosted-root",
        "summary": "创建根用户",
        "description": "1. 根用户只能存在一个，重复创建会响应 `409 Conflict`;\n2. License 通过云端验证，`cloud_url` 可配置，默认为 `https://api.swanlab.cn/api`\n\t1. license 过期响应 `403 Forbidden`;\n\t2. license 不存在响应 `404 Not Found`;\n\t3. 其他情况下响应 `502 Bad Gateway`;\n3. 创建成功响应 `201`;\n4. 根用户通过 `group.comment` 标识为 `root`;\n5. License 通过云端验证后会在本地创建 License 对象，用于后续验证。\n6. 商业版 license 必须在线验证，离线将以 `403` 返回",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password", "license"],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "license": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "username": "root",
                "password": "S3cure!pass",
                "license": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJsaWNlbnNlIjoic3RhbmRhcmQifQ.signature"
              }
            }
          },
          "description": "请求体",
          "required": true
        },
        "responses": {
          "201": {
            "description": "创建根用户成功，返回用户信息",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["username", "name", "avatar", "createdAt", "verified", "tag"],
                  "properties": {
                    "username": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "avatar": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string"
                    },
                    "verified": {
                      "type": "boolean"
                    },
                    "tag": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "username": "root",
                  "name": "Root Administrator",
                  "avatar": "https://api.swanlab.cn/avatars/root.png",
                  "createdAt": "2026-10-19T10:00:00Z",
                  "verified": true,
                  "tag": "admin"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 400,
                  "code": "Invalid_Request",
                  "message": "invalid request body"
                }
              }
            }
          },
          "403": {
            "description": "license 错误：License_Expired: 过期；License_Verification_Failed: token 错误；License_Activation_Expired: 超过激活截止时间；License_User_Count_Exceeded: 系统已有用户超过套餐最大用户数；License_Activation_Failed: 联网激活失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 403,
                  "code": "License_Expired",
                  "message": "license has expired"
                }
              }
            }
          },
          "409": {
            "description": "已有根用户，重复激活",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 409,
                  "code": "Root_Already_Exists",
                  "message": "root user already exists"
                }
              }
            }
          },
          "500": {
            "description": "异常错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 500,
                  "code": "Internal_Error",
                  "message": "internal server error"
                }
              }
            }
          }
        },
        "tags": ["根用户管理"]
      }
    },
    "/self_hosted/users": {
      "post": {
        "operationId": "self-hosted-create-users",
        "summary": "批量添加用户",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["users"],
                "properties": {
                  "users": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["username", "password"],
                      "properties": {
                        "username": {
                          "type": "string",
                          "description": "用户名，必选"
                        },
                        "password": {
                          "type": "string",
                          "description": "密码"
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "users": [
                  {
                    "username": "ada",
                    "password": "S3cure!pass"
                  },
                  {
                    "username": "bob",
                    "password": "S3cure!pass"
                  }
                ]
              }
            }
          },
          "description": "请求体",
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created，添加成功；已存在的用户及请求内重复的 username 会被跳过"
          },
          "401": {
            "description": "Unauthorized，未携带有效身份凭证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 401,
                  "code": "Unauthorized",
                  "message": "missing or invalid credentials"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden，无权增加用户；Max_Limit 组织人数达到限制，此次添加的用户将全部取消",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 403,
                  "code": "Max_Limit",
                  "message": "user limit exceeded"
                }
              }
            }
          }
        },
        "tags": ["用户管理"]
      }
    },
    "/self_hosted/user/password": {
      "post": {
        "operationId": "self-hosted-change-password",
        "summary": "根用户修改密码",
        "description": "1. 根用户可以修改所有用户的密码。\n2. 非根用户只能修改自己的密码。",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "username": "ada",
                "password": "N3w!passw0rd"
              }
            }
          },
          "description": "上述请求体包含的字段均为必填项，响应为空。",
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized，未携带有效身份凭证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 401,
                  "code": "Unauthorized",
                  "message": "missing or invalid credentials"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden，非 root 用户修改其他用户的密码",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 403,
                  "code": "Forbidden",
                  "message": "cannot change another user's password"
                }
              }
            }
          },
          "404": {
            "description": "Not Found 目标用户不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 404,
                  "code": "Not_Found",
                  "message": "user not found"
                }
              }
            }
          }
        },
        "tags": ["根用户管理"]
      }
    },
    "/self_hosted/user/pause": {
      "post": {
        "operationId": "self-hosted-pause-user",
        "summary": "超管停用指定用户",
        "description": "停用用户会删除该用户的 API Key 和会话缓存，但会保留 SSO ProviderUser 绑定记录。",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username"],
                "properties": {
                  "username": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "username": "ada"
              }
            }
          },
          "description": "请求体",
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content，停用成功并撤销该用户的登录凭证，返回空响应体"
          },
          "401": {
            "description": "Unauthorized，未携带有效身份凭证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 401,
                  "code": "Unauthorized",
                  "message": "missing or invalid credentials"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden 无权限停用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 403,
                  "code": "Forbidden",
                  "message": "no permission to pause the user"
                }
              }
            }
          },
          "404": {
            "description": "Not_Found 用户不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 404,
                  "code": "Not_Found",
                  "message": "user not found"
                }
              }
            }
          },
          "409": {
            "description": "Conflict 无法停用root用户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 409,
                  "code": "Conflict",
                  "message": "cannot pause the root user"
                }
              }
            }
          }
        },
        "tags": ["用户管理"]
      }
    },
    "/self_hosted/user/unpause": {
      "post": {
        "operationId": "self-hosted-unpause-user",
        "summary": "超管恢复指定用户",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username"],
                "properties": {
                  "username": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "username": "ada"
              }
            }
          },
          "description": "请求体",
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content 恢复成功，返回空响应体"
          },
          "401": {
            "description": "Unauthorized，未携带有效身份凭证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 401,
                  "code": "Unauthorized",
                  "message": "missing or invalid credentials"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden 无权限恢复",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 403,
                  "code": "Forbidden",
                  "message": "no permission to unpause the user"
                }
              }
            }
          },
          "404": {
            "description": "Not_Found 用户不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 404,
                  "code": "Not_Found",
                  "message": "user not found"
                }
              }
            }
          }
        },
        "tags": ["用户管理"]
      }
    },
    "/self_hosted/user/del": {
      "post": {
        "operationId": "self-hosted-delete-user",
        "summary": "超管删除成员",
        "description": "1. 只有根用户可以删除成员\n2. 根用户无法删除自己，否则 `409 Conflict`\n3. 删除操作为软删除, `user`表`status`和`group`表`type=PERSON`的`status`会变更为 `DISABLED`\n4. 会硬删除session表中所有关于该用户的会话信息\n5. 删除缓存中所有该用户的会话信息\n6. 若目标用户是某个非个人组织的管理员，则需要先进行退出组织/修改角色等操作\n7. 删除所有关联的项目、协作者、申请信息\n8. 删除该用户关联的 SSO ProviderUser 绑定记录",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username"],
                "properties": {
                  "username": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "username": "ada"
              }
            }
          },
          "description": "请求体",
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content，删除成功（软删除），返回空响应体"
          },
          "401": {
            "description": "Unauthorized，未携带有效身份凭证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 401,
                  "code": "Unauthorized",
                  "message": "missing or invalid credentials"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden 无权限删除",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 403,
                  "code": "Forbidden",
                  "message": "no permission to delete the user"
                }
              }
            }
          },
          "404": {
            "description": "Not_Found 用户不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 404,
                  "code": "Not_Found",
                  "message": "user not found"
                }
              }
            }
          },
          "409": {
            "description": "Conflict 无法删除root用户；Conflict 目标用户是某个组织的管理员（排除个人组织）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 409,
                  "code": "Conflict",
                  "message": "cannot delete the root user"
                }
              }
            }
          }
        },
        "tags": ["用户管理"]
      }
    },
    "/self_hosted/team/member": {
      "post": {
        "operationId": "self-hosted-upsert-team-member",
        "summary": "超管邀请&修改成员权限",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["group", "username", "role"],
                "properties": {
                  "group": {
                    "type": "string",
                    "description": "组织空间`username`，必选"
                  },
                  "username": {
                    "type": "string",
                    "description": "指定用户, 必选"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["OWNER", "MEMBER", "VIEWER"],
                    "description": "指定角色, 必选, `OWNER`, `MEMBER`, `VIEWER`"
                  }
                }
              },
              "example": {
                "group": "my-team",
                "username": "ada",
                "role": "MEMBER"
              }
            }
          },
          "description": "请求体",
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK，修改成功"
          },
          "401": {
            "description": "Unauthorized，未携带有效身份凭证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 401,
                  "code": "Unauthorized",
                  "message": "missing or invalid credentials"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden，对组织无权限邀请成员",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 403,
                  "code": "Forbidden",
                  "message": "no permission to invite members"
                }
              }
            }
          },
          "404": {
            "description": "Not Found：组织不存在；用户不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 404,
                  "code": "Not_Found",
                  "message": "organization or user not found"
                }
              }
            }
          },
          "409": {
            "description": "Conflict，组织内至少保留一名管理员（降级最后一名 OWNER 时返回）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 409,
                  "code": "Conflict",
                  "message": "organization must keep at least one owner"
                }
              }
            }
          }
        },
        "tags": ["用户管理"]
      }
    },
    "/self_hosted/team/member/del": {
      "post": {
        "operationId": "self-hosted-delete-team-member",
        "summary": "超管移除成员",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["group", "username"],
                "properties": {
                  "group": {
                    "type": "string",
                    "description": "组织空间 `username`，必选"
                  },
                  "username": {
                    "type": "string",
                    "description": "指定用户, 必选"
                  }
                }
              },
              "example": {
                "group": "my-team",
                "username": "ada"
              }
            }
          },
          "description": "请求体",
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content，移除成功"
          },
          "401": {
            "description": "Unauthorized，未携带有效身份凭证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 401,
                  "code": "Unauthorized",
                  "message": "missing or invalid credentials"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden，对组织无权限移除成员",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 403,
                  "code": "Forbidden",
                  "message": "no permission to remove members"
                }
              }
            }
          },
          "404": {
            "description": "Not Found：组织不存在；用户不存在；目标用户不是组织成员",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 404,
                  "code": "Not_Found",
                  "message": "organization or user not found"
                }
              }
            }
          },
          "409": {
            "description": "Conflict，组织最后一个管理员无法被移除",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 409,
                  "code": "Conflict",
                  "message": "cannot remove the last owner"
                }
              }
            }
          }
        },
        "tags": ["用户管理"]
      }
    },
    "/self_hosted/project/collaborator": {
      "post": {
        "operationId": "self-hosted-upsert-collaborator",
        "summary": "超管邀请协作者&修改协作者权限",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["project", "username", "role"],
                "properties": {
                  "project": {
                    "type": "string",
                    "description": "项目`cuid`，必选"
                  },
                  "username": {
                    "type": "string",
                    "description": "指定用户, 必选"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["READ", "WRITE", "ADMIN"],
                    "description": "指定角色, 必选, `READ`, `WRITE`,  `ADMIN`"
                  }
                }
              },
              "example": {
                "project": "clx8f3k2d0000abcd",
                "username": "ada",
                "role": "WRITE"
              }
            }
          },
          "description": "请求体",
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK，修改成功"
          },
          "400": {
            "description": "Reach_Max，单项目下协作者数量达上限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 400,
                  "code": "Reach_Max",
                  "message": "collaborator limit reached"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized，未携带有效身份凭证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 401,
                  "code": "Unauthorized",
                  "message": "missing or invalid credentials"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden，对项目无权限邀请协作者",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 403,
                  "code": "Forbidden",
                  "message": "no permission to invite collaborators"
                }
              }
            }
          },
          "404": {
            "description": "Not Found：项目不存在；目标用户不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 404,
                  "code": "Not_Found",
                  "message": "project or user not found"
                }
              }
            }
          }
        },
        "tags": ["协作者管理"]
      }
    },
    "/self_hosted/project/collaborator/del": {
      "post": {
        "operationId": "self-hosted-delete-collaborator",
        "summary": "超管删除协作者",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["project", "username"],
                "properties": {
                  "project": {
                    "type": "string",
                    "description": "项目 `cuid`"
                  },
                  "username": {
                    "type": "string",
                    "description": "用户的的 `username`"
                  }
                }
              },
              "example": {
                "project": "clx8f3k2d0000abcd",
                "username": "ada"
              }
            }
          },
          "description": "请求体",
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content，删除成功"
          },
          "401": {
            "description": "Unauthorized，未携带有效身份凭证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 401,
                  "code": "Unauthorized",
                  "message": "missing or invalid credentials"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden，无权限删除",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 403,
                  "code": "Forbidden",
                  "message": "no permission to remove collaborators"
                }
              }
            }
          },
          "404": {
            "description": "Not Found：用户不存在；项目不存在；用户不是项目协作者",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 404,
                  "code": "Not_Found",
                  "message": "project or user not found"
                }
              }
            }
          }
        },
        "tags": ["协作者管理"]
      }
    },
    "/auth/oauth2/token": {
      "post": {
        "operationId": "oauth2-token",
        "summary": "获取或刷新 Access Token",
        "description": "根据 authorization code 签发 access token 和 refresh token，或使用 refresh token 刷新 access token。",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["grant_type"],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": ["authorization_code", "refresh_token"],
                    "description": "授权类型"
                  },
                  "code": {
                    "type": "string",
                    "description": "传入回调地址的 authorization code"
                  },
                  "refresh_token": {
                    "type": "string",
                    "description": "refresh token"
                  }
                }
              },
              "example": {
                "grant_type": "authorization_code",
                "code": "8f3k2d6a1c9b4e7f0a2d5c8b"
              }
            }
          },
          "description": "请求体",
          "required": true
        },
        "responses": {
          "200": {
            "description": "成功获取或刷新 Access Token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["access_token", "expires_in"],
                  "properties": {
                    "access_token": {
                      "type": "string",
                      "description": "access token，有效期 2 小时"
                    },
                    "refresh_token": {
                      "type": "string",
                      "description": "refresh token，有效期 30 天（仅在 grant_type=authorization_code 时返回）"
                    },
                    "expires_in": {
                      "type": "integer",
                      "format": "int32",
                      "description": "access token 有效期（秒），固定为 7200"
                    }
                  }
                },
                "example": {
                  "access_token": "sl_at_9c1e4f7a2b6d8e0f3a5c7b9d",
                  "refresh_token": "sl_rt_2f6a8c0e4b7d9f1a3c5e7b9d",
                  "expires_in": 7200
                }
              }
            }
          },
          "400": {
            "description": "bad_request：请求体错误或 grant_type 不支持；error_code：code 无效、已过期或已被消费；error_token：refresh_token 无效或已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "example": {
                  "status": 400,
                  "code": "bad_request",
                  "message": "unsupported grant_type",
                  "description": "请求体错误或 grant_type 不支持"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized：Basic Auth 缺失、app_secret 错误，或 code / refresh token 不属于当前应用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "example": {
                  "status": 401,
                  "code": "unauthorized",
                  "message": "invalid app_secret",
                  "description": "Basic Auth 缺失、app_secret 错误，或 code / refresh token 不属于当前应用"
                }
              }
            }
          },
          "404": {
            "description": "not_found：app_id 不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "example": {
                  "status": 404,
                  "code": "not_found",
                  "message": "app_id not found",
                  "description": "app_id 不存在"
                }
              }
            }
          },
          "500": {
            "description": "parse_error：JSON 解析失败；random_error：生成 token 失败；database_error：Redis 操作失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "example": {
                  "status": 500,
                  "code": "database_error",
                  "message": "redis operation failed",
                  "description": "Redis 操作失败"
                }
              }
            }
          }
        },
        "tags": ["OAuth2 校验"]
      }
    },
    "/auth/oauth2/user/info": {
      "get": {
        "operationId": "oauth2-user-info",
        "summary": "获取用户信息",
        "description": "根据 access token 获取 SwanLab 用户公开信息。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取用户信息",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["username", "nickname", "avatar", "profile"],
                  "properties": {
                    "username": {
                      "type": "string",
                      "description": "SwanLab 用户名"
                    },
                    "nickname": {
                      "type": "string",
                      "description": "SwanLab 昵称"
                    },
                    "avatar": {
                      "type": "string",
                      "description": "用户头像 URL"
                    },
                    "profile": {
                      "type": "object",
                      "properties": {
                        "bio": {
                          "type": "string",
                          "description": "简介"
                        },
                        "website": {
                          "type": "string",
                          "description": "用户个人网站"
                        },
                        "location": {
                          "type": "string",
                          "description": "地址"
                        },
                        "idc": {
                          "type": "string",
                          "description": "国家或地区"
                        },
                        "organization": {
                          "type": "string",
                          "description": "公司或机构"
                        },
                        "education": {
                          "type": "string",
                          "description": "学校"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "username": "ada",
                  "nickname": "Ada",
                  "avatar": "https://api.swanlab.cn/avatars/ada.png",
                  "profile": {
                    "bio": "Machine learning engineer",
                    "website": "https://ada.dev",
                    "location": "Hangzhou",
                    "idc": "CN",
                    "organization": "SwanLab",
                    "education": "Zhejiang University"
                  }
                }
              }
            }
          },
          "400": {
            "description": "bad_request：缺少 token 或 Authorization 格式错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "example": {
                  "status": 400,
                  "code": "bad_request",
                  "message": "missing token",
                  "description": "缺少 token 或 Authorization 格式错误"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized：access token 不存在或已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "example": {
                  "status": 401,
                  "code": "unauthorized",
                  "message": "access token expired",
                  "description": "access token 不存在或已过期"
                }
              }
            }
          },
          "500": {
            "description": "error_internal：请求 SwanLab Server 用户信息失败；parse_error：token 数据解析失败；database_error：Redis 操作失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "example": {
                  "status": 500,
                  "code": "error_internal",
                  "message": "failed to fetch user info",
                  "description": "请求 SwanLab Server 用户信息失败"
                }
              }
            }
          }
        },
        "tags": ["用户信息获取"]
      }
    },
    "/auth/oauth2/user/api_key": {
      "get": {
        "operationId": "oauth2-user-api_key",
        "summary": "获取 API Key",
        "description": "根据 access token 获取该用户用于调用 SwanLab OpenAPI 的最新 API Key。实现逻辑与获取用户信息一致：Auth 将 access token 作为 Redis 索引解析出用户上下文，再请求 SwanLab Server 内部接口获取该用户最新的 API Key。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取 API Key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["api_key"],
                  "properties": {
                    "api_key": {
                      "type": "string",
                      "description": "用户最新的 API Key"
                    }
                  }
                },
                "example": {
                  "api_key": "sl_ak_4d7f9b1c3e5a7d0f2b4c6e8a"
                }
              }
            }
          },
          "400": {
            "description": "bad_request：缺少 token 或 Authorization 格式错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "example": {
                  "status": 400,
                  "code": "bad_request",
                  "message": "missing token",
                  "description": "缺少 token 或 Authorization 格式错误"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized：access token 不存在或已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "example": {
                  "status": 401,
                  "code": "unauthorized",
                  "message": "access token expired",
                  "description": "access token 不存在或已过期"
                }
              }
            }
          },
          "500": {
            "description": "error_internal：请求 SwanLab Server 获取 API Key 失败；parse_error：token 数据解析失败；database_error：Redis 操作失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "example": {
                  "status": 500,
                  "code": "error_internal",
                  "message": "failed to fetch api key",
                  "description": "请求 SwanLab Server 获取 API Key 失败"
                }
              }
            }
          }
        },
        "tags": ["用户信息获取"]
      }
    }
  },
  "servers": [
    {
      "url": "https://api.swanlab.cn/api",
      "description": "SwanLab 线上环境（api.swanlab.cn）"
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "description": "Authorization: Basic <app_id:app_secret(base64编码)>",
        "scheme": "basic"
      },
      "bearerAuth": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Authorization: Bearer <access_token>"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Authorization: ApiKey <实例 root 用户的 API Key>"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["status", "code", "message"],
        "properties": {
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "OAuthError": {
        "type": "object",
        "required": ["status", "code", "message"],
        "properties": {
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
